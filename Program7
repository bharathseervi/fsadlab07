    department: "Engineering",
    performance_score: {
        $gte: 4.5
    }
});


// QUERY 5: Employees in HR department
// OR salary greater than 100000
db.employees.find({
    $or: [
        { department: "HR" },
        { salary: { $gt: 100000 } }
    ]
});


// QUERY 6: Active employees in Engineering or Sales
db.employees.find({
    status: "Active",
    department: {
        $in: ["Engineering", "Sales"]
    }
});
