db.employees.find({
    salary: {
        $gt: 90000,
        $lte: 120000
    }
});


// QUERY 2: Find employees in HR or Sales department
db.employees.find({
    department: {
        $in: ["HR", "Sales"]
    }
});


// QUERY 3: Find employees whose status is On Leave
